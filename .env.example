# Copy this file to .env (and .env.local for secrets you don't want in
# version control) and fill in real values. Never commit the real .env file.

# --- Database (Neon Postgres) ---------------------------------------------
# Pooled connection string, used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&pgbouncer=true"
# Direct (non-pooled) connection string, used only by `prisma migrate`.
# On Neon this is the same host without the "-pooler" suffix.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# --- Tracker auth ----------------------------------------------------------
# Shared secret between the VS Code extension and this API. Generate one with:
#   openssl rand -hex 32
TRACKER_API_TOKEN="replace-with-a-long-random-value"

# --- Timezone ---------------------------------------------------------------
# IANA timezone used to compute "today", streaks, and weekly totals.
APP_TIMEZONE="Africa/Lagos"
